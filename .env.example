# fathom env — copy to .env, everything is optional with sane defaults.
# read ONLY by src/config.ts.

# server
FATHOM_PORT=4950
# dns-rebinding defense: comma-separated host[:port] allowlist (empty = any)
FATHOM_ALLOWED_HOSTS=

# data sources
# this machine's id, as recorded on every usage event it ingests (default: hostname)
FATHOM_MACHINE=
# where ~/.claude lives on this machine
FATHOM_CLAUDE_DIR=
FATHOM_DB_PATH=

# polling cadence
FATHOM_SCAN_INTERVAL_SEC=20
# the oauth usage endpoint is heavily rate limited — keep this slow
FATHOM_RATELIMIT_INTERVAL_SEC=600

# dashboard thresholds
# a session counts as "active" if it had an assistant message within this window
FATHOM_ACTIVE_WINDOW_SEC=900
# a machine counts as "online" if seen within this window
FATHOM_STALE_SEC=300

# ingest (windows agent -> laptop)
# shared secret the agent must send as x-fathom-token. defense-in-depth against
# another tailnet device posting by accident, not a security boundary — empty
# (default) skips the check.
FATHOM_INGEST_TOKEN=
